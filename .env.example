# Copy to .env at workspace root. Used by local dev and production-mode local preview.
# Use your provider-issued PostgreSQL TCP URL, preferably a separate hosted development database.
# Preserve the provider TLS parameters. Prisma Client remains the ORM; no local DB/Docker is required.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@your-database.example.invalid:5432/amc_development?sslmode=verify-full
# DIRECT_URL=postgresql://USER:PASSWORD@your-direct-database.example.invalid:5432/amc_development?sslmode=verify-full
# Optional Docker alternative only: pnpm dev:setup:docker with a local amc_*_dev URL.
# POSTGRES_USER=amc_dev
# POSTGRES_PASSWORD=local_only_password
# POSTGRES_DB=amc_dev
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Set only to the verified public origin before publishing. Without it: noindex.
# NEXT_PUBLIC_SITE_URL=https://your-verified-domain
# Optional isolated database for tests; never production.
# TEST_DATABASE_URL=postgresql://amc_dev:local_only_password@127.0.0.1:5432/amc_test
# Public content is a review draft until copy is approved and a real origin is set.
# NEXT_PUBLIC_CONTENT_APPROVED=true
# Verified details only; unset values show the bilingual unavailable state.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_OFFICE_ADDRESS_EN=
# NEXT_PUBLIC_OFFICE_ADDRESS_AR=
# NEXT_PUBLIC_MAPS_URL=
# Optional owner-supplied Google Maps /maps/embed URL, loaded on demand in onsite booking.
# NEXT_PUBLIC_OFFICE_MAP_EMBED_URL=
# Private server-side staff proxy; never use a NEXT_PUBLIC prefix for this.
STAFF_API_ORIGIN=http://127.0.0.1:4000
# Local-only staff setup: pnpm staff:dev:setup. Passwords are generated into ignored .env.dev-staff.
# These example.invalid identities are never real staff or production credentials.
DEV_MANAGER_EMAIL=dev-manager@example.invalid
DEV_RECEPTIONIST_EMAIL=dev-receptionist@example.invalid
# Production API requires a generated secret of at least 64 characters.
# STAFF_CSRF_SECRET=
# Migration/admin URL. Leave unset to use the local DATABASE_URL in development.
# For hosted dev, set the provider direct URL for the SAME database in this .env.
# Setup checks migration history read-only; apply reviewed hosted migrations separately.
# DIRECT_URL=
# Vercel production Node runtime compatibility for the installed Nest dependencies:
# NODE_OPTIONS=--experimental-require-module
# Normal Vercel deployments do not apply production migrations.
# Production schema changes require a separate reviewed migration run against the
# verified direct database URL; keep release authorization values out of persistent settings.
# Server-side shared signing key for web/API; production requires 64+ random characters.
# STAFF_PROXY_SECRET=
# API-only credential used by the Vercel maintenance cron.
# CRON_SECRET=
# Optional owner-authorized bypass for protected API deployments.
# STAFF_API_BYPASS_TOKEN=

# Booking API signing secret: 64+ random characters, separate from staff secrets.
# BOOKING_TOKEN_SECRET=
# Enable only after owner approval of real booking policy, office details and privacy.
# BOOKING_APPROVED=false

# Contact form delivery (Phase 1). Without these the inquiry is still stored; the matching step is skipped.
# Resend: use a verified almorad-amc.com sender for real-recipient delivery checks.
# RESEND_API_KEY=
# RESEND_BOOKING_FROM_EMAIL="ALMORAD AMC <bookings@almorad-amc.com>"
# RESEND_FROM_EMAIL="ALMORAD AMC <info@almorad-amc.com>"
# REPLY_TO_EMAIL=info@almorad-amc.com
# Studio inbox that receives the new-inquiry alert.
# CONTACT_INBOX_EMAIL=info@almorad-amc.com
# Separate staff alert inbox for new appointments; client receipts still go to the client.
# BOOKING_INBOX_EMAIL=bookings@almorad-amc.com
# HubSpot server-only private-app token. Enable contacts read/write and the scopes
# shown for meeting search/create/update in the HubSpot app. No custom objects required.
# HUBSPOT_ACCESS_TOKEN=
# Account ID from the HubSpot URL, for authenticated staff CRM links only.
# HUBSPOT_PORTAL_ID=
# Existing writable inquiry message property (confirmed present in the inspected account).
# HUBSPOT_CONTACT_MESSAGE_PROPERTY=message
# Absolute site URL used in email headers/footers (defaults to https://almorad-amc.com).
# EMAIL_SITE_URL=

# Docker-free production-mode local preview:
# pnpm dev:setup -> pnpm preview:cert -> pnpm preview:build -> pnpm preview:local
# Open https://localhost:4443. Both apps run NODE_ENV=production behind local TLS.
# The generated self-signed certificate is NOT installed into system trust.
# Optional existing localhost certificate paths (relative to workspace or absolute):
# LOCAL_HTTPS_CERT=
# LOCAL_HTTPS_KEY=
# LOCAL_OPENSSL=
# Existing real provider settings are preserved. Browser submissions send real mail.
# Use a controlled recipient and hosted development DB for manual delivery checks.

# Optional controlled recipient for pnpm email:test (sends ONE real email; no database writes).
# EMAIL_TEST_TO=
