{
  "name": "@amc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node ../../scripts/stage-api-runtime.mjs && node ../../scripts/check-api-runtime.mjs",
    "start": "node --env-file=../../.env dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:demo": "tsx --env-file=../../.env prisma/seed.ts",
    "staff:provision": "tsx --env-file=../../.env prisma/provision-staff.ts",
    "staff:dev:setup": "tsx --env-file=../../.env prisma/provision-dev-staff.ts"
  },
  "dependencies": {
    "@amc/shared": "workspace:*",
    "@js-temporal/polyfill": "0.5.1",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.11.0",
    "dotenv": "^17.2.0",
    "google-auth-library": "11.3.4",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.37.0",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
