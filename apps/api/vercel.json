{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nestjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node ../../scripts/ci/vercel-api-build.mjs",
  "crons": [
    {
      "path": "/ops/maintenance",
      "schedule": "0 3 * * *"
    }
  ],
  "outputDirectory": "dist/apps/api/src",
  "functions": {
    "dist/apps/api/src/main.js": {
      "includeFiles": "{dist/apps/api/src/node_modules/**,dist/apps/api/src/package.json}"
    }
  }
}
