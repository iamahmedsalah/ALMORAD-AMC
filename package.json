{
  "name": "almorad-amc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@amc/web",
    "dev:api": "turbo run dev --filter=@amc/api",
    "dev:db": "docker compose --env-file .env -f dev/postgres/compose.yml up -d --wait postgres",
    "dev:db:stop": "docker compose --env-file .env -f dev/postgres/compose.yml stop postgres",
    "dev:setup": "node scripts/local-runtime.mjs setup",
    "db:migrate:dev": "node scripts/dev-migrations.mjs",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run build --filter=@amc/shared && vitest run",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @amc/api db:generate",
    "db:validate": "pnpm --filter @amc/api db:validate",
    "db:migrate": "pnpm --filter @amc/api db:migrate",
    "db:seed:demo": "node scripts/demo.mjs setup",
    "test:e2e": "pnpm --filter @amc/shared build && playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "icons:generate": "node scripts/generate-solar.mjs",
    "staff:provision": "pnpm --filter @amc/api staff:provision",
    "staff:dev:setup": "pnpm --filter @amc/api staff:dev:setup",
    "db:backup:local": "node scripts/db-safety.mjs backup",
    "db:restore:check": "node scripts/db-safety.mjs rehearse",
    "test:e2e:staff": "playwright test --config playwright.staff.config.ts",
    "ops:smoke": "node scripts/health-smoke.mjs",
    "demo:setup": "node scripts/demo.mjs setup",
    "dev:demo": "node scripts/demo.mjs dev",
    "preview:demo": "node scripts/demo.mjs preview",
    "ci:release:test": "node --test scripts/ci/*.test.mjs",
    "db:release:inspect": "node scripts/ci/migrations.mjs inspect",
    "db:release:deploy": "node scripts/ci/migrations.mjs deploy",
    "dev:setup:docker": "pnpm dev:db && pnpm db:migrate:dev",
    "db:check": "node scripts/local-runtime.mjs check",
    "preview:cert": "node scripts/local-runtime.mjs cert",
    "preview:build": "node scripts/local-runtime.mjs build",
    "preview:local": "node scripts/local-runtime.mjs preview",
    "crm:check": "node scripts/check-hubspot.mjs",
    "email:test": "node scripts/test-email.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.39.0",
    "@iconify-json/solar": "1.2.13",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.20.0",
    "turbo": "2.11.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "type": "module"
}
